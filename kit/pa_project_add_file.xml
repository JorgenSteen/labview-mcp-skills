<VI _name="pa_project_add_file.vi" description="Adds one existing file (e.g. a new empty .lvlib) to the ACTIVE project directly under My Computer\3A Project\3AActive Project -&gt; {LV.Project} My Computer -&gt; {LV.TargetItem} AddFile (Path). Spellings from NI's example Add Files to Project.vi. The close saves the project\3B move the item into its folder with lvproj_move.py afterwards. Project OPEN and ACTIVE. Measured in an evaluation\2C 2026-10.">
  <Control _name="file to add" type="path" uid="7001" uid_parent="root" value="" outputs="value:7001.value"/>
  <Node _name="Property Node" fields="read+Project\3AActive Project" type="{LV.Application}" inputs="error in (no error):" outputs="Project\3AActive Project:7010.proj,reference out:,error out:7010.err" uid="7010" uid_parent="root"/>
  <Node _name="Property Node" fields="read+My Computer" type="{LV.Project}" inputs="reference:7010.proj,error in (no error):7010.err" outputs="My Computer:7020.mc,reference out:,error out:7020.err" uid="7020" uid_parent="root"/>
  <Indicator _name="my computer error" type="cluster{bool.status,int32.code,string.source}" uid="7021" uid_parent="root" value="[false,0,]" inputs="value:7020.err"/>
