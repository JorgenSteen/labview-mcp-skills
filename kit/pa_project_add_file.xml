  <Indicator _name="add file error" type="cluster{bool.status,int32.code,string.source}" uid="7031" uid_parent="root" value="[false,0,]" inputs="value:7030.err"/>
  <Node _name="Close Reference" inputs="reference:7030.item,error in (no error):7030.err" outputs="error out:7040.err" uid="7040" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:7020.mc,error in (no error):7040.err" outputs="error out:7050.err" uid="7050" uid_parent="root"/>
  <Indicator _name="error out" type="cluster{bool.status,int32.code,string.source}" uid="7091" uid_parent="root" value="[false,0,]" inputs="value:7050.err"/>
</VI>
